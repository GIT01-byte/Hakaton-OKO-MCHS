FROM ubuntu:22.04

# Устанавливаем зависимости для графики и Python
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    wget \
    python3 \
    python3-pip \
    libgl1-mesa-glx \
    libxrender1 \
    libxtst6 \
    x11-utils

# Скачиваем и устанавливаем Webots
RUN wget https://github.com/cyberbotics/webots/releases/download/R2025a/webots_2025a_amd64.deb && \
    apt install -y ./webots_2025a_amd64.deb && \
    rm webots_2025a_amd64.deb


# Команда по умолчанию
CMD ["bash"]